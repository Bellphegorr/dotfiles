root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cmd,ps1}]
end_of_line = crlf

[*.ps1]
indent_style = space
indent_size = 4

[*.{json,yaml,yml,css,md}]
indent_style = space
indent_size = 2

[config/zed/*.json]
indent_size = 4

[config/windows-terminal/settings.json]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
