{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.41/schema.json",
  "app_specific_configuration_path": "$Env:USERPROFILE/dotfiles/applications.json",
  "manage_rules": [
    [
      {
        "kind": "Class",
        "id": "HwndWrapper[DefaultDomain",
        "matching_strategy": "StartsWith"
      }
    ],
    [
      {
        "kind": "Class",
        "id": "TaskManagerWindow",
        "matching_strategy": "Legacy"
      }
    ],
    [
      {
        "kind": "Title",
        "id": "Conectar",
        "matching_strategy": "Equals"
      }
    ],
    [
      {
        "kind": "Exe",
        "id": "Ssms.exe",
        "matching_strategy": "Equals"
      }
    ]
  ],
  "window_hiding_behaviour": "Cloak",
  "cross_monitor_move_behaviour": "Insert",
  "default_workspace_padding": 5,
  "default_container_padding": 5,
  "border": true,
  "border_width": 4,
  "border_style": "Square",
  "border_offset": -1,
  "theme": {
    "palette": "Base16",
    "name": "BlackMetalBathory",
    "unfocused_border": "Base03",
    "bar_accent": "Base0D"
  },
  "display_index_preferences": {
    "0": "GSM7714-4&1112cff6&0&UID198171",
    "1": "GSM59C4-4&1112cff6&0&UID200195"
  },
  "monitors": [
    {
      "workspaces": [
        {
          "name": "\uf120",
          "layout": "VerticalStack"
        },
        {
          "name": "\udb80\udd69",
          "layout": "VerticalStack"
        },
        {
          "name": "\uf268",
          "layout": "VerticalStack"
        },
        {
          "name": "\udb80\ude4b",
          "layout": "VerticalStack"
        },
        {
          "name": "\uf4b8",
          "layout": "VerticalStack"
        },
        {
          "name": "\udb80\udf72",
          "layout": "VerticalStack"
        },
        {
          "name": "\uf111",
          "layout": "VerticalStack"
        }
      ]
    },
    {
      "workspaces": [
        {
          "name": "\uf111",
          "layout": "Rows"
        },
        {
          "name": "\uf111",
          "layout": "Grid"
        }
      ]
    }
  ]
}
