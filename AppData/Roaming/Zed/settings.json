// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    "agent": {
        "commit_message_model": {
            "model": "gpt-5-mini",
            "provider": "copilot_chat"
        },
        "dock": "right",
        "favorite_models": [],
        "inline_assistant_model": {
            "model": "gpt-5.4",
            "provider": "copilot_chat"
        },
        "model_parameters": [],
        "sidebar_side": "right"
    },
    "agent_servers": {
        "github-copilot-cli": {
            "default_config_options": {
                "allow_all": "on",
                "model": "gpt-5.4",
                "reasoning_effort": "xhigh"
            },
            "favorite_config_option_values": {
                "allow_all": ["on"],
                "model": ["gpt-5.4", "claude-opus-4.6"],
                "reasoning_effort": ["xhigh"]
            },
            "type": "registry"
        }
    },
    "auto_install_extensions": {
        "angular": true,
        "csharp": true,
        "editorconfig": true,
        "html": true,
        "matte-black": true,
        "nord": true
    },
    "autoscroll_on_clicks": true,
    "base_keymap": "VSCode",
    "buffer_font_family": "JetBrainsMono Nerd Font",
    "collaboration_panel": {
        "dock": "left"
    },
    "cursor_blink": false,
    "cursor_shape": "block",
    "edit_predictions": {
        "provider": "copilot"
    },
    "git_panel": {
        "dock": "left"
    },
    "gutter": {
        "folds": false
    },
    "icon_theme": {
        "mode": "dark",
        "light": "Min Icons",
        "dark": "Zed (Default)"
    },
    "indent_guides": {
        "enabled": false
    },
    "minimap": {
        "show": "never"
    },
    "outline_panel": {
        "dock": "left"
    },
    "preview_tabs": {
        "enabled": false
    },
    "project_panel": {
        "auto_fold_dirs": false,
        "dock": "left",
        "indent_guides": {
            "show": "never"
        },
        "show_diagnostics": "off"
    },
    "sticky_scroll": {
        "enabled": false
    },
    "tab_bar": {
        "show": false,
        "show_nav_history_buttons": false,
        "show_tab_bar_buttons": false
    },
    "theme": {
        "dark": "Matte Black",
        "light": "Gruvbox Light",
        "mode": "dark"
    },
    "toolbar": {
        "agent_review": false,
        "breadcrumbs": true,
        "code_actions": false,
        "quick_actions": false,
        "selections_menu": false
    },
    "wrap_guides": [120],
    "wsl_connections": [
        {
            "distro_name": "Ubuntu",
            "user": null,
            "projects": [
                {
                    "paths": ["/home/jose/git/BilhetagemServicosAdicionais"]
                },
                {
                    "paths": ["/home/jose/git/PlanosDeServico"]
                }
            ]
        }
    ]
}
